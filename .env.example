# Firebase (klient) — local + Vercel.
# NEXT_PUBLIC_* řádky vezmi z konzole Firebase (Project settings → Your apps).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server). Preferuj cestu k souboru (local):
# FIREBASE_SERVICE_ACCOUNT_JSON=.firebase-service-account.json
# nebo celý JSON v jednoduchých uvozovkách na jeden řádek (hosting).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin e-maily (čárkou oddělené) – plný přístup k API i /admin (kromě přidávání adminů).
# Další adminy s omezenými právy přidává jen jiri@esportarena.cz v Admin → Přidat administrátora.
ADMIN_EMAILS=jiri@esportarena.cz

# Stejné e-maily jako ADMIN_EMAILS pro přesměrování po přihlášení na /admin (jen pro účty mimo super admin).
# Bez tohoto tě po přihlášení nepustí klient na /admin (i když ADMIN_EMAILS na serveru funguje pro API).
# NEXT_PUBLIC_ADMIN_EMAILS=admin@skola.cz,druhy@domena.cz

# Volitelně: project ID jen pro server (JWT ověření bez správného NEXT_PUBLIC při buildu)
# FIREBASE_PROJECT_ID=tvoj-projekt-id

# Dočasný náhled /admin bez přihlášení — cookie na 7 dní (po odladění env smaž)
# Varianta A (rizikové na produkci): odkomentuj — stačí /admin-docasny-pristup bez parametru
# ADMIN_DOCASNY_JEN_CESTA=1
# Varianta B (doporučeno): nastav token a otevři /admin-docasny-pristup?t=STEJNÝ_TOKEN
# ADMIN_DOCASNY_TOKEN=nahodny_dlouhy_retezec

# Discord webhook kanál Reports (logy: registrace, týmy, turnaje, podpora…)
# Preferuj DISCORD_REPORTS_WEBHOOK_URL; DISCORD_WEBHOOK_URL zůstává jako alias.
DISCORD_REPORTS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Discord webhook do kanálu Oznámení (nová oznámení z adminu na web)
DISCORD_ANNOUNCEMENTS_WEBHOOK_URL=

# Tajný klíč pro POST /api/announcements/from-discord (Discord bot)
DISCORD_ANNOUNCEMENTS_SECRET=

# URL pro Discord bota (produkce), např. https://tvuj-web.example
ANNOUNCEMENTS_INGEST_URL=

# Resend (potvrzovací e-maily kapitánům: welcome, profil, odeslání týmu)
# Bez RESEND_API_KEY + RESEND_FROM API vrací 503 a e-mail nedorazí.
# RESEND_FROM musí být z ověřené domény v Resend (nebo onboarding@resend.dev jen pro test).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
ADMIN_ALERT_EMAIL=jiri@esportarena.cz

# Faceit Data API
FACEIT_API_KEY=

# Volitelné: hero pozadí — .mp4 v public/fotky (doporučeno); YouTube URL = jen statický náhled
# NEXT_PUBLIC_HERO_VIDEO_URL=/fotky/X_ARENA_image_vid.mp4
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_KICK_CHANNEL=

# Veřejná URL webu (SEO, e-maily, sitemap, Open Graph).
# Na produkci MUSÍ být oficiální doména (bez koncového /):
NEXT_PUBLIC_SITE_URL=https://studentskyturnaj.cz


# Cron: mazání dokladů 24 h po schválení týmu, LFG inzerátů, smazání účtů po odkladu.
# Na Vercelu MUSÍ být CRON_SECRET vyplněné — Vercel ho posílá jako Authorization: Bearer …
# a bez něj endpoint odmítne úklid. Hobby plán umí cron jen 1× denně; Pro / externí
# cron (cron-job.org) každou hodinu dodrží těch 24 h přesněji. Netlify vercel.json cron nespouští.
CRON_SECRET=

# Jednorázové ukázkové inzeráty LFG (volitelné): npm run seed:lfg

# Po schválení – odkaz na Faceit kvalifikaci (zobrazí se týmu)
NEXT_PUBLIC_FACEIT_HUB_URL=https://www.faceit.com/
