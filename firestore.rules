rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Kapitáni a hráči (uid = document ID) ---
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountRole in ['captain', 'player']
        && request.resource.data.keys().hasAll([
          'email', 'phone', 'discordUsername', 'faceitNickname',
          'steamNickname', 'isAdult', 'profileComplete', 'accountRole'
        ]);
      // E-mail v dokumentu = e-mail z Auth tokenu (update vždy posílá email z klienta).
      // Pole naplánovaného smazání, role a propojení s týmem smí měnit jen Admin SDK / REST.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'firstName', 'lastName', 'phone', 'discordUsername', 'faceitNickname',
          'steamNickname', 'riotId', 'brawlPlayerTag', 'eaAccount', 'isAdult',
          'parentConsentUrl', 'studentCertUrl', 'profileComplete',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // --- Týmy (schvalování řeší Admin SDK / API na serveru) ---
    match /teams/{teamId} {
      allow read: if request.auth != null
        && resource.data.captainId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.captainId == request.auth.uid
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['accountRole'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountRole == 'captain'
        )
        && request.resource.data.gameId in ['cs2', 'brawl_stars', 'lol', 'fc26']
        && request.resource.data.status == 'pending'
        && request.resource.data.captainEmail == request.auth.token.email
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() > 0
        && request.resource.data.teamName.size() <= 200
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.schoolName.size() <= 200
        && request.resource.data.schoolFullName is string
        && request.resource.data.schoolFullName.size() > 0
        && request.resource.data.schoolFullName.size() <= 300
        && request.resource.data.captainDiscord is string
        && request.resource.data.captainDiscord.size() <= 120
        && request.resource.data.teammates is list
        && request.resource.data.substitutes is list
        && request.resource.data.coach is map
        && request.resource.data.storageMeta is list;

      allow update: if request.auth != null
        && resource.data.captainId == request.auth.uid
        && request.resource.data.captainId == resource.data.captainId
        && request.resource.data.gameId in ['cs2', 'brawl_stars', 'lol', 'fc26']
        && (
          (resource.data.keys().hasAll(['gameId'])
            && resource.data.gameId == request.resource.data.gameId)
          || (!resource.data.keys().hasAll(['gameId'])
            && request.resource.data.gameId == 'cs2')
        )
        && resource.data.status in ['pending', 'approved']
        && request.resource.data.status == resource.data.status
        && request.resource.data.captainEmail == resource.data.captainEmail
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 200
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() <= 200
        && request.resource.data.schoolFullName is string
        && request.resource.data.schoolFullName.size() > 0
        && request.resource.data.schoolFullName.size() <= 300
        && request.resource.data.captainDiscord is string
        && request.resource.data.captainDiscord.size() <= 120
        && request.resource.data.teammates is list
        && request.resource.data.substitutes is list
        && request.resource.data.coach is map
        && request.resource.data.storageMeta is list;

      allow delete: if false;
    }

    // --- Ban list e-mailů (jen Admin SDK / API — blok registrace) ---
    match /bannedEmails/{emailId} {
      allow read, write: if false;
    }

    // --- Oznámení (zápis jen přes Admin SDK / API) ---
    match /announcements/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Turnaje (veřejně jen published; zápis jen Admin SDK / API) ---
    match /tournaments/{tournamentId} {
      allow read: if resource.data.published == true;
      allow write: if false;

      match /registrations/{teamId} {
        allow read: if get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.published == true;
        allow write: if false;
      }
    }

    // --- CMS stránek (čtení veřejně, zápis jen Admin SDK / API) ---
    match /page_content/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // --- LFG / free agents (inzerát přidá kdokoli bez účtu; mazání jen cron / Admin) ---
    match /free_agents/{docId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
            'type', 'gameId', 'discordUsername', 'hoursPlayed', 'faceitLevel',
            'description', 'createdAt'
          ])
        && request.resource.data.type in ['looking_team', 'looking_player']
        && request.resource.data.gameId in ['cs2', 'lol', 'brawl_stars', 'fc26']
        && request.resource.data.discordUsername is string
        && request.resource.data.discordUsername.size() > 0
        && request.resource.data.discordUsername.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 4000
        && (request.resource.data.hoursPlayed is int
            || request.resource.data.hoursPlayed is float)
        && request.resource.data.hoursPlayed >= 0
        && request.resource.data.hoursPlayed <= 50000
        && (request.resource.data.faceitLevel is int
            || request.resource.data.faceitLevel is float)
        && request.resource.data.faceitLevel >= 0
        && request.resource.data.faceitLevel <= 10
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
