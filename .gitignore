# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (šablona .env.example se commituje)
.env
.env.local
.env.*.local
.env.development
.env.production

# vercel
.vercel

# Cloudflare / OpenNext
.open-next
.wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo

# lokální kopie fotek mimo public/ (assety patří do public/fotky/)
/fotky/

# Local Firebase service account (never commit)
.firebase-service-account.json
.env.local.bak-firebase

# Lokální poznámky / originály velkých videí
emaily*.txt
public/fotky/*.original.mp4
